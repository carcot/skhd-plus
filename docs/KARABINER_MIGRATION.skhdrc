    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
.remap caps_lock [device builtin] [app "org.gnu.Emacs"] : passthrough
.remap caps_lock [device builtin] [app "org.shirakumo.portacle"] : passthrough

.remap tab [device builtin] [app "com.apple.Terminal"] {
    tap: tab
    hold: lctrl
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
