.remap rcmd [device builtin] {
    tap: f19
    tap_modifier: rcmd
    hold: rcmd
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
.remap rshift [device builtin] {
    tap: f18
    hold: rshift
    timeout: 250ms
    permissive_hold: off
    hold_on_other_key_press: on
}
.remap ralt [device builtin] {
    tap: f19
    tap_modifier: ralt
    hold: ralt
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
