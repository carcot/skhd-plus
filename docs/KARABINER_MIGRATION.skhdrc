f18 : /Applications/YabaiSpaces.app/Contents/MacOS/YabaiIndicator panel activate-selected-or-show
alt - f19 : /Applications/YabaiSpaces.app/Contents/MacOS/YabaiIndicator window next-in-space
cmd - f19 : /Applications/YabaiSpaces.app/Contents/MacOS/YabaiIndicator space next-recent
cmd - 0x2F : /Applications/YabaiSpaces.app/Contents/MacOS/YabaiIndicator space next-recent

.device builtin { vendor: 0x05AC, product: 0x0343 }

.remap caps_lock [device builtin] {
    tap: f20
    hold: lcmd
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}

.remap caps_lock [device builtin] [app "com.apple.Terminal"] {
    tap: f20
    hold: rctrl
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
.remap caps_lock [device builtin] [app "com.github.wez.wezterm"] {
    tap: f20
    hold: rctrl
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
.remap caps_lock [device builtin] [app "com.googlecode.iterm2"] {
    tap: f20
    hold: rctrl
    timeout: 500ms
    permissive_hold: off
    hold_on_other_key_press: on
}
